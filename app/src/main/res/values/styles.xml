<resources>
    <style name="Widget.Calculator.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">18sp</item>
        <item name="backgroundTint">@color/calculator_surface</item>
        <item name="android:textColor">@color/calculator_primary</item>
    </style>

    <style name="Widget.Calculator.ButtonOperator" parent="Widget.Calculator.Button">
        <item name="backgroundTint">@color/calculator_operator</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.Calculator.ButtonAccent" parent="Widget.Calculator.Button">
        <item name="backgroundTint">@color/calculator_accent</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
</resources>
